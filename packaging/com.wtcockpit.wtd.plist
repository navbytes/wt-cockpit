<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.wtcockpit.wtd</string>

	<key>ProgramArguments</key>
	<array>
		<string>/usr/local/bin/wtd</string>
		<!-- Add flags here if you don't use ~/.config/wtcockpit/config.toml, e.g.: -->
		<!-- <string>-root</string> -->
		<!-- <string>/Users/YOUR_USER/code</string> -->
	</array>

	<key>RunAtLoad</key>
	<true/>
	<!-- Restart only on failure (mirrors the systemd unit's Restart=on-failure);
	     plain <true/> would also respawn a cleanly-exiting or misconfigured wtd forever. -->
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>

	<!-- launchd does not expand "~" — replace YOUR_USER with your actual home
	     directory before loading this plist (see packaging/README.md). -->
	<key>StandardOutPath</key>
	<string>/Users/YOUR_USER/Library/Logs/wtcockpit/wtd.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/YOUR_USER/Library/Logs/wtcockpit/wtd.log</string>
</dict>
</plist>
