{{define "content"}}
<div class="topbar">
  <div class="brand"><span>wt</span> cockpit</div>
  <div class="spacer"></div>
  <a class="back" href="/">&larr; worktrees</a>
</div>
{{if .NotFound}}
<div class="card">
  <h2>worktree not found</h2>
  <p>no worktree with id <code>{{.ID}}</code> — it may have been merged or removed.</p>
  <p><a href="/">&larr; back to worktrees</a></p>
</div>
{{else}}
<div class="pane-h">
  <span class="title">{{.Repo}} / {{.Name}}</span>
  <span class="base">reviewing working tree vs <code>{{.Base}}</code></span>
  <span class="sum">{{.TotalFiles}} files · <span class="add">+{{.Stats.Add}}</span> <span class="del">&minus;{{.Stats.Del}}</span> · <span class="chip {{.Agent}}">{{.Agent}}</span></span>
</div>
{{if .GuardrailMsg}}
<div class="alert"><span>&#9888;</span><div><b>Guardrail:</b> {{.GuardrailMsg}}{{if .GuardrailMore}} <span class="more">(+{{.GuardrailMore}} more)</span>{{end}}</div></div>
{{end}}
<div id="banner" class="banner hidden" role="alert"></div>
{{if .Empty}}
<div class="card empty-diff"><p class="empty">no changes vs <code>{{.Base}}</code></p></div>
{{else}}
<div class="review-wrap" data-id="{{.ID}}" data-diff-hash="{{.DiffHash}}">
  <div class="review-main">
    <div class="diff" id="diff">
      {{range .Files}}
      <div class="file" id="file-{{.Idx}}">
        <div class="file-h {{if .Danger}}flag{{end}}">
          <span class="fname"><span class="path">{{.Dir}}</span>{{.FileName}}</span>
          {{if .Danger}}<span class="tag danger">danger</span>{{else if ne (print .Status) "modified"}}<span class="tag">{{.Status}}</span>{{end}}
          <span class="fnums"><span class="add">+{{.Stats.Add}}</span> <span class="del">&minus;{{.Stats.Del}}</span></span>
          <label class="rev-check"><input type="checkbox" class="rev-toggle card-toggle" data-file="{{.Path}}" data-file-hash="{{.Hash}}" {{if .Reviewed}}checked{{end}}> reviewed</label>
        </div>
        {{if .Binary}}
        <p class="note">binary file</p>
        {{else if .Collapsed}}
        <p class="note">{{.CollapseNote}} — <a href="?expand={{.Path}}">expand</a></p>
        {{else}}
          {{if .HighlightOff}}<p class="note">highlighting off (large file)</p>{{end}}
          {{range .Hunks}}
          <div class="hunk-h">{{.Header}}</div>
          <div class="sxs">
            <div class="side">
              <div class="side-lab">before · {{$.Base}}</div>
              {{range .Rows}}<div class="srow {{.Left.Kind}}"><span class="ln">{{if .Left.Num}}{{.Left.Num}}{{end}}</span><span class="code chroma">{{.Left.HTML}}</span></div>{{end}}
            </div>
            <div class="side">
              <div class="side-lab">after · working tree</div>
              {{range .Rows}}<div class="srow {{.Right.Kind}}"><span class="ln">{{if .Right.Num}}{{.Right.Num}}{{end}}</span><span class="code chroma">{{.Right.HTML}}</span></div>{{end}}
            </div>
          </div>
          {{end}}
        {{end}}
      </div>
      {{end}}
    </div>
  </div>
  <div class="rail">
    <h4>Files in this worktree</h4>
    <div class="flist">
      {{range .Files}}
      <div class="fitem {{if .Reviewed}}done{{end}}">
        <input type="checkbox" class="rev-toggle rail-toggle" data-file="{{.Path}}" data-file-hash="{{.Hash}}" {{if .Reviewed}}checked{{end}}>
        <a class="fn" href="#file-{{.Idx}}" title="{{.DisplayPath}}">{{.DisplayPath}}</a>
        <span class="n"><span class="add">+{{.Stats.Add}}</span> <span class="del">&minus;{{.Stats.Del}}</span></span>
      </div>
      {{end}}
    </div>
    <div class="foot">
      <div class="prog-lab"><span>Reviewed</span><span id="prog-txt">{{.ReviewedCount}} / {{.TotalFiles}}</span></div>
      <div class="progress"><i id="prog-bar" style="width:{{.ProgressPct}}%"></i></div>
      <button class="btn merge" id="approve-btn" data-id="{{.ID}}" data-base="{{.Base}}" {{if not .AllReviewed}}disabled{{end}}>{{if .AllReviewed}}&#10003; Approve &amp; merge to {{.Base}}{{else}}&#10003; Approve &amp; merge ({{.LeftCount}} left){{end}}</button>
      <div id="approve-error" class="approve-error hidden" role="alert"></div>
    </div>
  </div>
</div>
{{end}}
<div id="terminal" class="card hidden">
  <h2>merged</h2>
  <p>merged into <code id="terminal-base"></code>, worktree removed.</p>
  <p><a href="/">&larr; back to worktrees</a></p>
</div>
{{end}}
{{end}}
