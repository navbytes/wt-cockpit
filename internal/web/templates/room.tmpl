{{define "content"}}
<div class="topbar">
  <h1 class="brand"><span>wt</span> cockpit</h1>
  <span id="sse-chip" class="sse-chip hidden" role="status">live updates paused — retrying</span>
  <div class="spacer"></div>
  <a class="back" href="/">&larr; worktrees</a>
</div>
{{if .NotFound}}
<div class="card">
  <h2>worktree not found</h2>
  <p>no worktree with id <code>{{.ID}}</code> — it may have been merged or removed.</p>
  <p><a href="/">&larr; back to worktrees</a></p>
</div>
{{else}}
<div class="pane-h" data-id="{{.ID}}" data-diff-hash="{{.DiffHash}}">
  <h2 class="title">{{.Repo}} / {{.Name}}</h2>
  <span class="base">reviewing working tree vs <code>{{.Base}}</code></span>
  <span class="sum">{{.TotalFiles}} files · <span class="add">+{{.Stats.Add}}</span> <span class="del">&minus;{{.Stats.Del}}</span> · <span class="chip {{.Agent}}">{{.Agent}}</span></span>
</div>
{{if .GuardrailMsg}}
<div class="alert{{if eq .GuardrailSeverity "danger"}} danger{{end}}"><span>&#9888;</span><div><b>Guardrail:</b> {{.GuardrailMsg}}{{if .GuardrailMore}} <span class="more">(+{{.GuardrailMore}} more)</span>{{end}}</div></div>
{{end}}
<div id="proto-banner" class="banner hidden" role="alert">wtd was upgraded — reload</div>
<div id="banner" class="banner hidden" role="alert"></div>
{{if .Empty}}
<div class="card empty-diff"><p class="empty">no changes vs <code>{{.Base}}</code></p></div>
{{else}}
<div class="review-wrap" data-id="{{.ID}}" data-diff-hash="{{.DiffHash}}">
  <div class="review-main">
    <div class="diff" id="diff">
      {{range $fc := .Files}}
      <div class="file" id="file-{{$fc.Idx}}">
        <div class="file-h {{if $fc.HitSeverity}}flag{{end}}">
          <span class="fname"><span class="path">{{$fc.Dir}}</span>{{$fc.FileName}}</span>
          {{if ne (print $fc.Status) "modified"}}<span class="tag">{{$fc.Status}}</span>{{end}}
          {{if $fc.HitSeverity}}<span class="tag {{$fc.HitSeverity}}">{{$fc.HitSeverity}}</span>{{end}}
          <span class="fnums"><span class="add">+{{$fc.Stats.Add}}</span> <span class="del">&minus;{{$fc.Stats.Del}}</span></span>
          <label class="rev-check"><input type="checkbox" class="rev-toggle card-toggle" data-file="{{$fc.Path}}" data-file-hash="{{$fc.Hash}}" {{if $fc.Reviewed}}checked{{end}}> reviewed</label>
          <button type="button" class="btn ghost c-add" data-file="{{$fc.Path}}" data-file-idx="{{$fc.Idx}}" data-line="0" data-side="new" title="comment on this file">&#9998; comment</button>
        </div>
        {{template "fileCommentsStrip" $fc}}
        {{if $fc.Binary}}
        <p class="note">binary file</p>
        {{else if $fc.Collapsed}}
        <p class="note">{{$fc.CollapseNote}} — <a href="?expand={{$fc.Path}}">expand</a></p>
        {{else}}
          {{if $fc.HighlightOff}}<p class="note">highlighting off (large file)</p>{{end}}
          {{range $fc.Hunks}}
          <div class="hunk-h">{{.Header}}</div>
          <div class="sxs">
            <div class="side">
              <div class="side-lab">before · {{$.Base}}</div>
              <div class="srows">
              {{range .Rows}}<div class="srow {{.Left.Kind}}"><span class="ln">{{if .Left.Num}}<button type="button" class="ln-btn" data-file="{{$fc.Path}}" data-file-idx="{{$fc.Idx}}" data-line="{{.Left.Num}}" data-side="old" title="comment on this line">{{.Left.Num}}</button>{{end}}</span><span class="code chroma">{{.Left.HTML}}</span></div>{{end}}
              </div>
            </div>
            <div class="side">
              <div class="side-lab">after · working tree</div>
              <div class="srows">
              {{range .Rows}}<div class="srow {{.Right.Kind}}"><span class="ln">{{if .Right.Num}}<button type="button" class="ln-btn" data-file="{{$fc.Path}}" data-file-idx="{{$fc.Idx}}" data-line="{{.Right.Num}}" data-side="new" title="comment on this line">{{.Right.Num}}</button>{{end}}</span><span class="code chroma">{{.Right.HTML}}</span></div>{{end}}
              </div>
            </div>
          </div>
          {{end}}
        {{end}}
      </div>
      {{end}}
    </div>
  </div>
  <div class="rail" id="rail">
    {{template "rail" .}}
  </div>
</div>
{{end}}
{{template "orphanedComments" .OrphanedComments}}
<div id="terminal" class="card hidden">
  <h2>merged</h2>
  <p>merged into <code id="terminal-base"></code>, worktree removed.</p>
  <p><a href="/">&larr; back to worktrees</a></p>
</div>
{{template "composerTemplate"}}
{{end}}
{{end}}
