{{define "content"}}
<div class="topbar">
  <h1 class="brand"><span>wt</span> cockpit</h1>
  <span id="sse-chip" class="sse-chip hidden" role="status">live updates paused — retrying</span>
  <div class="spacer"></div>
  <div class="stat"><b>{{.Counts.Worktrees}}</b> worktrees</div>
  <div class="stat"><b>{{.Counts.Active}}</b> active</div>
  <div class="stat rev"><b>{{.Counts.Unreviewed}}</b> unreviewed</div>
  <div class="stat warn"><b>{{.Counts.Alerts}}</b> alert{{if ne .Counts.Alerts 1}}s{{end}}</div>
</div>
<div id="proto-banner" class="banner hidden" role="alert">wtd was upgraded — reload</div>
<div id="worktrees">{{template "worktrees" .}}</div>
{{end}}

{{define "worktrees"}}
{{if not .Groups}}
<p class="empty">no worktrees under
  {{range $i, $r := .Roots}}{{if $i}}, {{end}}<code>{{$r}}</code>{{end}}
  — <code>wtd -root &lt;dir&gt;</code> or edit config.toml</p>
{{else}}
{{range .Groups}}
<h2 class="proj">{{.Repo}}</h2>
{{range .Worktrees}}
<a class="wt {{.State}}" href="/wt/{{.ID}}">
  <span class="dot" title="{{.State}}" aria-label="{{.State}}"></span>
  <span class="main">
    <span class="name">{{.Name}}</span>
    <span class="sub">
      <span class="chip {{.Agent}}">{{.Agent}}</span>
      <span class="time">{{reltime .LastChange}}</span>
    </span>
  </span>
  <span class="nums">
    <span class="add">+{{.Stats.Add}}</span> <span class="del">-{{.Stats.Del}}</span>
    <span class="files">{{.Stats.Files}} files</span>
  </span>
  {{if .Guardrails}}<span class="badge-alert {{.Severity}}" title="{{guardrails .Guardrails}}">&#9888;</span>{{end}}
</a>
{{end}}
{{end}}
{{end}}
{{end}}
